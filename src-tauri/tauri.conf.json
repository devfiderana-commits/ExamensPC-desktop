{
  "productName": "EXAMENS",
  "version": "0.1.0",
  "identifier": "com.examens.app",
  "build": {
    "beforeDevCommand": "python3 -m http.server 8000 --directory src",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:8000",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "EXAMENS - Gestion des Sujets d'Examens",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:8000; img-src 'self' data: blob: file:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://localhost:8000;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
